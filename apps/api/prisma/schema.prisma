// MM AI Platform: PostgreSQL schema (MVP-02).
// pgvector: the database image ships the extension, but nothing here enables or uses it yet.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum MessageRole {
  USER
  ASSISTANT
}

enum MessageStatus {
  GENERATING
  COMPLETED
  STOPPED
  FAILED
  INTERRUPTED
}

model User {
  id            String         @id @default(uuid(7)) @db.Uuid
  email         String         @unique
  displayName   String
  passwordHash  String
  role          Role           @default(USER)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  lastLoginAt   DateTime?      @db.Timestamptz(3)
  sessions      Session[]
  conversations Conversation[]
  documents     Document[]

  @@map("users")
}

model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  // SHA-256 of the opaque token; the token itself is never stored.
  tokenHash  String    @unique
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Conversation {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  title     String
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id                  String        @id @default(uuid(7)) @db.Uuid
  conversationId      String        @db.Uuid
  // Per-conversation position, assigned under a conversation row lock: deterministic ordering.
  seq                 Int
  role                MessageRole
  content             String
  status              MessageStatus @default(COMPLETED)
  errorCode           String?
  // Idempotency key supplied by the browser for USER messages (retry must not duplicate a turn).
  clientRequestId     String?       @db.Uuid
  generationStartedAt DateTime?     @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @default(now()) @db.Timestamptz(3)
  conversation        Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, seq])
  @@unique([conversationId, clientRequestId])
  @@index([status, generationStartedAt])
  @@map("messages")
}

enum DocumentKind {
  PDF
  DOCX
  TXT
}

enum DocumentStatus {
  PENDING
  PROCESSING
  READY
  PARTIAL
  FAILED
  OCR_REQUIRED
}

enum JobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

model Document {
  id                 String                 @id @default(uuid(7)) @db.Uuid
  userId             String                 @db.Uuid
  originalFilename   String
  // Internal, server-generated key (never derived from user input); the file lives outside any public directory.
  storageKey         String                 @unique
  kind               DocumentKind
  mediaType          String
  sizeBytes          Int
  sha256             String
  status             DocumentStatus         @default(PENDING)
  extractionMetadata Json?
  errorCode          String?
  // Chunks of exactly this generation are the published result; others are staging or stale.
  activeGeneration   String?                @db.Uuid
  createdAt          DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime               @default(now()) @db.Timestamptz(3)
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks             DocumentChunk[]
  job                DocumentProcessingJob?

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, status])
  @@index([userId, kind])
  @@map("documents")
}

model DocumentChunk {
  id                String   @id @default(uuid(7)) @db.Uuid
  documentId        String   @db.Uuid
  // The processing job (attempt) that produced this chunk; publication switches Document.activeGeneration.
  generation        String   @db.Uuid
  chunkIndex        Int
  content           String
  pageStart         Int?
  pageEnd           Int?
  heading           String?
  section           String?
  // Extra source location metadata, for example the legal articles contained in the chunk.
  location          Json?
  charStart         Int
  charEnd           Int
  estimatedTokens   Int
  processingVersion String
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, generation, chunkIndex])
  @@map("document_chunks")
}

model DocumentProcessingJob {
  id             String    @id @default(uuid(7)) @db.Uuid
  // One job per document (unique): retries reuse the row, so duplicate jobs cannot exist.
  documentId     String    @unique @db.Uuid
  status         JobStatus @default(PENDING)
  attempts       Int       @default(0)
  // Claim: only the holder of leaseToken may publish; an expired lease can be claimed again.
  leaseToken     String?   @db.Uuid
  leaseExpiresAt DateTime? @db.Timestamptz(3)
  runAfter       DateTime  @default(now()) @db.Timestamptz(3)
  startedAt      DateTime? @db.Timestamptz(3)
  finishedAt     DateTime? @db.Timestamptz(3)
  errorCode      String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @default(now()) @db.Timestamptz(3)
  document       Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([status, runAfter])
  @@map("document_processing_jobs")
}
