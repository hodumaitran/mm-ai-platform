AI_SERVICE_ENV=development
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
AI_SERVICE_LOG_LEVEL=INFO
# AI_SERVICE_LLM_PROVIDER=ollama
AI_SERVICE_LLM_MAX_CONCURRENCY=1
AI_SERVICE_LLM_REQUEST_TIMEOUT_SECONDS=120
AI_SERVICE_LLM_DEFAULT_TEMPERATURE=0.2
AI_SERVICE_LLM_DEFAULT_MAX_OUTPUT_TOKENS=1024
AI_SERVICE_LLM_DEFAULT_CONTEXT_WINDOW=4096
AI_SERVICE_OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_SERVICE_OLLAMA_MODEL=qwen3.5:35b
AI_SERVICE_OLLAMA_NETWORK_POLICY=loopback
AI_SERVICE_OLLAMA_CONNECT_TIMEOUT_SECONDS=5
AI_SERVICE_OLLAMA_READ_TIMEOUT_SECONDS=120
AI_SERVICE_OLLAMA_READINESS_TIMEOUT_SECONDS=3
AI_SERVICE_OLLAMA_READINESS_CACHE_SECONDS=10
