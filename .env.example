API_HOST=127.0.0.1
API_PORT=3001
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- MVP-02: database and authentication (apps/api reads these from its own .env) ---
# Local PostgreSQL on loopback only (a non-loopback host is rejected at startup).
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/mm_ai
# Database whose name MUST end with _test; the test suites truncate it.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/mm_ai_test
# At least 32 random characters (for example: python -c "import secrets;print(secrets.token_urlsafe(48))").
SESSION_SECRET=
# Optional, defaults shown.
# SESSION_TTL_SECONDS=43200
# SESSION_COOKIE_SECURE=false          # defaults to true when NODE_ENV=production
# APP_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW_SECONDS=900
# GENERATION_STALE_SECONDS=360
# First administrator (used only by `pnpm --filter @mm-ai/api admin:bootstrap`; pass them for that one command):
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_DISPLAY_NAME=
