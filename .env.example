API_HOST=127.0.0.1
API_PORT=3001
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- MVP-02: database and authentication (apps/api reads these from its own .env) ---
# Local PostgreSQL on loopback only (a non-loopback host is rejected at startup).
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/mm_ai
# Database whose name MUST end with _test; the test suites truncate it.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/mm_ai_test
# At least 32 random characters (for example: python -c "import secrets;print(secrets.token_urlsafe(48))").
SESSION_SECRET=
# Optional, defaults shown.
# SESSION_TTL_SECONDS=43200
# SESSION_COOKIE_SECURE=false          # defaults to true when NODE_ENV=production
# APP_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW_SECONDS=900
# GENERATION_STALE_SECONDS=360
# First administrator (used only by `pnpm --filter @mm-ai/api admin:bootstrap`; pass them for that one command):
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_DISPLAY_NAME=

# --- MVP-03: documents (configurable safety limits, not verified capacity) ---
# API: private storage for original uploads. Must not be inside a publicly served directory.
# DOCUMENT_STORAGE_DIR=./storage
# The upload size limit must match in all three places (default 50 MiB):
# DOCUMENT_MAX_BYTES=52428800                      (apps/api and apps/web)
# AI_SERVICE_DOCUMENT_MAX_BYTES=52428800           (apps/ai-service)
# DOCUMENT_MAX_CONCURRENCY=1
# DOCUMENT_JOB_LEASE_SECONDS=90
# DOCUMENT_JOB_TIMEOUT_SECONDS=660                 (must exceed the AI service timeout)
# DOCUMENT_MAX_ATTEMPTS=3
# DOCUMENT_POLL_INTERVAL_MS=2000
# DOCUMENT_WORKER_ENABLED=true
# DOCUMENT_ORPHAN_GRACE_SECONDS=600
# AI service extraction limits (defaults shown):
# AI_SERVICE_DOCUMENT_MAX_PDF_PAGES=5000
# AI_SERVICE_DOCUMENT_PROCESS_TIMEOUT_SECONDS=600
# AI_SERVICE_DOCUMENT_MAX_CONCURRENCY=1
# AI_SERVICE_DOCUMENT_MAX_EXTRACTED_CHARS=40000000
# AI_SERVICE_DOCUMENT_MAX_CHUNKS=100000
# AI_SERVICE_DOCUMENT_CHUNK_TARGET_TOKENS=512
# AI_SERVICE_DOCUMENT_CHUNK_OVERLAP_TOKENS=64
# AI_SERVICE_DOCUMENT_CHUNK_MAX_TOKENS=768
# AI_SERVICE_DOCUMENT_WORKER_MEMORY_LIMIT_BYTES=2147483648
